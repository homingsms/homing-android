    <string name="onboarding_mode_local_body">同一 Wi-Fi 下的应用调用此手机上运行的 API，数据不离开你的网络。</string>
    <string name="onboarding_mode_cloud">Homing Cloud</string>
    <string name="onboarding_mode_cloud_body">任何地方的应用都可调用 Homing Cloud API，由这部手机领取并发送消息。</string>
    <string name="onboarding_mode_both">两者都用</string>
    <string name="onboarding_mode_both_body">同时运行本地 API 并保持连接 Homing Cloud。</string>

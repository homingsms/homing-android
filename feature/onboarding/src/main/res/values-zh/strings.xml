    <string name="onboarding_oem_open">打开手机设置</string>
    <string name="onboarding_oem_xiaomi">Xiaomi、Redmi 和 POCO 还需设置</string>
    <string name="onboarding_oem_xiaomi_1">打开“设置”&gt;“应用设置”&gt;“应用管理”&gt;“Homing”。</string>
    <string name="onboarding_oem_xiaomi_2">开启“自启动”。</string>
    <string name="onboarding_oem_xiaomi_3">点按“省电策略”，选择“无限制”。</string>
    <string name="onboarding_oem_samsung">三星手机还需设置</string>
    <string name="onboarding_oem_samsung_1">打开“设置”&gt;“电池”&gt;“后台使用限制”。</string>
    <string name="onboarding_oem_samsung_2">将 Homing 添加到“从不休眠的应用程序”。</string>
    <string name="onboarding_oem_samsung_3">关闭“将未使用的应用程序置于休眠状态”，或确认 Homing 不在该列表中。</string>
    <string name="onboarding_oem_huawei">华为和荣耀手机还需设置</string>
    <string name="onboarding_oem_huawei_1">打开“设置”&gt;“电池”&gt;“应用启动管理”。</string>
    <string name="onboarding_oem_huawei_2">找到 Homing，关闭“自动管理”。</string>
    <string name="onboarding_oem_huawei_3">开启“允许自启动”“允许关联启动”和“允许后台活动”。</string>
    <string name="onboarding_oem_oppo">OPPO、realme 和一加手机还需设置</string>
    <string name="onboarding_oem_oppo_1">打开“设置”&gt;“电池”&gt;“应用耗电管理”&gt;“Homing”。</string>
    <string name="onboarding_oem_oppo_2">开启“允许后台行为”和“允许自动启动”。</string>
    <string name="onboarding_oem_tecno">Tecno、Infinix 和 itel 手机还需设置</string>
    <string name="onboarding_oem_tecno_1">打开“手机管家”&gt;“自启动管理”，允许 Homing。</string>
    <string name="onboarding_oem_tecno_2">打开“设置”&gt;“电池”&gt;“应用省电”，将 Homing 设为“无限制”。</string>
    <string name="onboarding_oem_lock_recents">打开最近任务，长按 Homing 并点按锁定图标。</string>
    <string name="onboarding_oem_other">其他大多数手机</string>
    <string name="onboarding_oem_other_1">打开“设置”&gt;“应用”&gt;“Homing”&gt;“电池”，选择“不受限制”。</string>
    <string name="onboarding_oem_other_2">保持 Homing 的通知开启，让系统知道它正在工作。</string>
    <string name="onboarding_restricted_title">允许受限设置</string>
    <string name="onboarding_restricted_body">Android 13 及以上版本会阻止非应用商店安装的应用访问短信，直到你手动允许一次。</string>
    <string name="onboarding_restricted_step_1">点按下方的“打开应用信息”。</string>
    <string name="onboarding_restricted_step_2">点按顶部角落的三点菜单。</string>
    <string name="onboarding_restricted_step_3">点按“允许受限设置”，然后用 PIN 码或指纹确认。</string>
    <string name="onboarding_restricted_step_4">返回此处继续。</string>
    <string name="onboarding_restricted_open">打开应用信息</string>

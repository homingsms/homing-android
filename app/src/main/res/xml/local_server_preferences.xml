<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/server">
        <EditTextPreference
            app:defaultValue="8080"
            app:icon="@drawable/ic_server"
            app:key="localserver.PORT"
            app:title="@string/port"
            app:useSimpleSummaryProvider="true" />
        <Preference
            android:icon="@drawable/ic_device_info"
            android:key="transient.device_id"
            android:persistent="false"
            android:title="@string/device_id"
            app:enableCopying="true" />
    </PreferenceCategory>
    <PreferenceCategory
        app:key="api_keys"
        app:title="@string/api_keys">
        <Preference
            android:icon="@drawable/ic_key"
            android:key="transient.create_api_key"
            android:persistent="false"
            android:title="@string/create_api_key" />
    </PreferenceCategory>
    <Preference
        app:icon="@drawable/ic_restart"
        app:summary="@string/restart_required_to_apply_changes" />
</PreferenceScreen>

<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/server">
        <Preference
            android:icon="@drawable/ic_server"
            android:key="transient.cloud_server"
            android:persistent="false"
            android:title="@string/server_address"
            app:enableCopying="true" />
        <Preference
            android:icon="@drawable/ic_device_info"
            android:key="transient.device_id"
            android:persistent="false"
            android:title="@string/device_id"
            app:enableCopying="true" />
        <Preference
            android:icon="@drawable/ic_pin"
            android:key="transient.pair"
            android:persistent="false"
            android:title="@string/pair_device" />
        <Preference
            android:icon="@drawable/ic_clear"
            android:key="transient.unpair"
            android:persistent="false"
            android:title="@string/unregister_device" />
    </PreferenceCategory>
</PreferenceScreen>

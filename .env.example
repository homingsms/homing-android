# Release signing for Homing. Copy to .env and fill in real values, or export
# these variables in your shell or CI. Without them, assembleRelease still
# builds an unsigned release APK.

# Path to the release keystore, relative to the app module or absolute.
# Defaults to app/keystore.jks.
SIGNING_KEY_STORE_PATH=keystore.jks

# Password for the keystore file.
SIGNING_STORE_PASSWORD=your-keystore-password

# Alias of the signing key inside the keystore.
SIGNING_KEY_ALIAS=your-key-alias

# Password for the signing key.
SIGNING_KEY_PASSWORD=your-key-password

# Optional: override the default cloud API base URL baked into BuildConfig.
# HOMING_CLOUD_URL=https://api.homingsms.com/mobile/v1
